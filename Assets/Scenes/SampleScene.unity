    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.15
  m_Text: "<b>FARMING, INVENTORY & THE MERCHANT:</b>\n\u2022 <b>WASD</b>: Move character\n\u2022
    <b>1 - 9 / Scroll</b>: Select Hotbar Slot\n\u2022 <b>Left Click</b>: Till / Water
    / Shovel / Plant / Harvest\n\u2022 <b>E</b>: Talk to The Merchant\n\u2022 Click
    <b>[INVENTORY]</b>: Open / Close Storage\n\u2022 <b>The Merchant</b>: BUY rotating
    seeds (2m) & SELL crops\n\u2022 <b>Shovel</b>: Digs up and removes planted seeds/crops\n\u2022
    <b>T</b>: Advance to Next Day (after 7 PM)\n<i>[1] Hoe  [2] Water Can  [3] Shovel 
    [4..9] Seeds</i>"
