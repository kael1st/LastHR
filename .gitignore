# ==============================================================================
# Unity Comprehensive .gitignore
# Prevents large generated files, caches, builds, and temporary files from being tracked
# ==============================================================================

# ------------------------------------------------------------------------------
# Huge Unity Caches & Generated Directories (Multi-Gigabytes)
# ------------------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
.utmp/

# ------------------------------------------------------------------------------
# In-Project Screenshots & Capture Artifacts
# ------------------------------------------------------------------------------
/[Aa]ssets/[Ss]creenshots/
/[Aa]ssets/[Ss]creenshots.meta
/[Aa]ssets/[Cc]aptures/
/[Aa]ssets/[Cc]aptures.meta

# ------------------------------------------------------------------------------
# Build Outputs & Executables
# ------------------------------------------------------------------------------
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
*.exe
*.dll
*.so
*.dylib
*.iso
*.dmg
*.pkg

# ------------------------------------------------------------------------------
# Large Compressed Archives & Raw Media Dumps
# ------------------------------------------------------------------------------
*.zip
*.tar.gz
*.tar
*.rar
*.7z
*.gz

# Video files (often huge; should not be committed directly into git history)
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.flv

# ------------------------------------------------------------------------------
# Blender & 3D Backup Files
# ------------------------------------------------------------------------------
*.blend1
*.blend1.meta
*.blend2
*.blend2.meta

# ------------------------------------------------------------------------------
# IDE, Editor & Tool Caches
# ------------------------------------------------------------------------------
.vs/
.idea/
.vscode/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Unity3D generated metadata for ignored debug files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash logs & system info
sysinfo.txt
mono_crash.*
crashlytics-build.properties
*.log

# Profiler & memory dumps
*.rawpixel
*.trace
*.dump
*.dmp
*.heap

# ------------------------------------------------------------------------------
# Addressables & Visual Scripting Generated Cache
# ------------------------------------------------------------------------------
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
/[Aa]ssets/[Ss]ceneDependencyCache*

# ------------------------------------------------------------------------------
# OS-Specific Junk Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
